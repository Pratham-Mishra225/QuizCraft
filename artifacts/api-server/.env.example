# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database — MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/quiz-master-hub

# Authentication — Generate a strong random 256-bit secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Gemini AI Integration (Required for AI Quiz generation from text & PDF)
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# CORS / Frontend origin (URL where quiz-app frontend is hosted)
FRONTEND_URL=http://localhost:5173

# Stage 9: RAG & PDF Pipeline Configuration
EMBEDDING_MODEL=text-embedding-004
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
PDF_MAX_PAGES=50
